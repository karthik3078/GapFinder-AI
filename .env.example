# Offline demo works without a key; no remote calls are made with these defaults.
AI_MODE=demo
EMBEDDING_PROVIDER=local
GEMINI_API_KEY=
# Availability depends on your Google account; replace with models you can access.
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GENERATION_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=60
RETRIEVAL_MIN_SIMILARITY=0.12
MAPPING_MIN_CONFIDENCE=0.22
STORAGE_DIR=storage
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
SEED_DEMO_USER=true
MAX_UPLOAD_MB=10
